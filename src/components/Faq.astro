---
import SectionHeader from './SectionHeader.astro';
import { faqs } from '../config/site';
---

<section id="faq" class="container-lux py-24">
  <SectionHeader
    index="08"
    eyebrow="FAQ"
    title="Asked about me"
    subtitle="Short answers for recruiters, collaborators, and search engines."
  />

  <div class="mx-auto max-w-3xl space-y-4">
    {faqs.map((f) => (
      <details class="glow-card reveal group px-6 py-5">
        <summary class="cursor-pointer list-none font-display text-base font-semibold text-white [&::-webkit-details-marker]:hidden">
          <span class="flex items-center justify-between gap-4">
            {f.q}
            <span class="text-xl text-blue-300 transition-transform duration-300 group-open:rotate-45">+</span>
          </span>
        </summary>
        <p class="mt-3 leading-relaxed text-gray-400">{f.a}</p>
      </details>
    ))}
  </div>
</section>
