---
import { site } from '../config/site';
---

<section id="contact" class="relative overflow-hidden px-5 py-36 sm:px-8 lg:px-12">
  <div class="aurora"></div>
  <div class="relative z-10 mx-auto max-w-[1400px] text-center">
    <span class="eyebrow reveal">Contact</span>
    <h2 class="reveal display mt-5 text-gray-100">
      Have a system
      <span class="block gradient-text">to ship?</span>
    </h2>
    <p class="reveal mx-auto mt-8 max-w-xl text-lg text-gray-400">
      I am open to full-time ML roles, freelance builds, and research
      collaborations in computer vision and MLOps. Email works fastest.
    </p>

    <div class="reveal mt-10 flex flex-wrap items-center justify-center gap-4">
      <a href={site.cvUrl} target="_blank" rel="noopener noreferrer" class="magnetic glow rounded-2xl bg-emerald-500 px-10 py-4 text-lg font-semibold text-white shadow-[0_10px_36px_-10px_rgba(30,128,255,0.8)] transition-colors hover:bg-emerald-600">
        Read my CV
      </a>
      <a href="/signal" class="magnetic rounded-2xl border border-white/15 px-10 py-4 text-lg font-medium text-gray-200 transition-colors hover:border-blue-400/60 hover:text-blue-300">
        Send a message
      </a>
    </div>

    <div class="reveal mt-12 flex items-center justify-center gap-8">
      <a href={site.social.github} target="_blank" rel="me noopener noreferrer" class="text-sm tracking-wide text-gray-400 transition-colors hover:text-emerald-400">GitHub</a>
      <span class="h-4 w-px bg-white/15"></span>
      <a href={site.social.linkedin} target="_blank" rel="me noopener noreferrer" class="text-sm tracking-wide text-gray-400 transition-colors hover:text-emerald-400">LinkedIn</a>
    </div>
  </div>
</section>
