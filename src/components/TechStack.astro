---
// Marquee two rows. Kept in sync with the stacks of the shipped projects.
// Row 1 = ML / CV / OCR core. Row 2 = LLM, data, and full-stack delivery.
// Marks, labels, and fallbacks all come from lib/tech-icons, the same source
// the project pages use, so a logo is added or renamed in exactly one place.
import { techMeta } from '../lib/tech-icons';
const row1 = [
  'Python',
  'PyTorch',
  'TensorFlow',
  'ONNX',
  'OpenCV',
  'Scikit-learn',
  'NumPy',
  'Pandas',
  'Keras',
  'RapidOCR',
  'PaddleOCR',
  'Tesseract',
  'RAG',
  'LLM',
];
const row2 = [
  'FastAPI',
  'Docker',
  'PostgresSQL',
  'MySQL',
  'MongoDB',
  'SQLite',
  'ChromaDB',
  'Groq',
  'Ollama',
  'Next.js',
  'React',
  'TypeScript',
  'TailwindCSS',
  'Node.js',
  'Git',
  'Linux',
  'Vercel',
  'Railway',
];

const all1 = [...row1, ...row1].map(techMeta);
const all2 = [...row2, ...row2].map(techMeta);
---

<section id="tech-stack" class="relative overflow-hidden py-16">
  <p class="container-lux eyebrow mb-8 text-center">Tools & Technologies I work with</p>

  <div class="marquee mb-4">
    <div class="marquee-track marquee-l">
      {all1.map((t) => (
          <div class="flex flex-shrink-0 items-center gap-3 rounded-xl border border-blue-400/15 bg-blue-500/5 px-5 py-3 transition-colors hover:border-blue-400/50">
          {t.icon
            ? <img src={t.icon} alt="" width="26" height="26" loading="lazy" class="h-6 w-6 object-contain" />
            : <span class="tech-badge__mono" aria-hidden="true">{t.mono}</span>}
          <span class="whitespace-nowrap font-display font-medium text-gray-200">{t.label}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="marquee">
    <div class="marquee-track marquee-r">
      {all2.map((t) => (
          <div class="flex flex-shrink-0 items-center gap-3 rounded-xl border border-blue-400/15 bg-blue-500/5 px-5 py-3 transition-colors hover:border-blue-400/50">
          {t.icon
            ? <img src={t.icon} alt="" width="26" height="26" loading="lazy" class="h-6 w-6 object-contain" />
            : <span class="tech-badge__mono" aria-hidden="true">{t.mono}</span>}
          <span class="whitespace-nowrap font-display font-medium text-gray-200">{t.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
