---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import projectsRaw from '../../data/project_details.json';
import { orderedProjects } from '../../lib/projects';
import { techStack } from '../../lib/tech-icons';
import { breadcrumbSchema } from '../../lib/schema';
import { SITE_URL } from '../../config/site';

const projects = orderedProjects(projectsRaw);
// Five marks on the card, the rest stays in the detail page.
const CARD_STACK = 5;
const stacks = new Map(projects.map((p) => [p.id, techStack(p.technologies_grouped)]));
const CATEGORY_ORDER = ['ML', 'Web', 'IoT', 'DE', 'Mobile', 'PM', 'QA'];
const categories = CATEGORY_ORDER.filter((c) => projects.some((p) => p.category === c));
const monthIdx: Record<string, number> = { january: 1, february: 2, march: 3, april: 4, may: 5, june: 6, july: 7, august: 8, september: 9, october: 10, november: 11, december: 12, jan: 1, feb: 2, mar: 3, apr: 4, jun: 6, jul: 7, aug: 8, sep: 9, sept: 9, oct: 10, nov: 11, dec: 12 };
const sortKey = (t: string) => {
  const years = [...t.matchAll(/\d{4}/g)].map((m) => parseInt(m[0]));
  const year = years.length ? years[years.length - 1] : 0;
  const months = [...t.toLowerCase().matchAll(/(january|february|march|april|may|june|july|august|september|october|november|december|jan|feb|mar|apr|jun|jul|aug|sep|sept|oct|nov|dec)/g)].map((m) => monthIdx[m[0]] ?? 0);
  const month = months.length ? months[months.length - 1] : 0;
  return year * 100 + month;
};
const schema = [
  breadcrumbSchema([{ name: 'Home', url: '/' }, { name: 'Projects', url: '/projects' }]),
  {
    '@type': 'ItemList',
    '@id': `${SITE_URL}/projects#list`,
    name: 'All projects by Aldy Ardiansyah',
    itemListElement: projects.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: p.name,
      url: `${SITE_URL}/projects/${p.id}`,
    })),
  },
];
---

<PageLayout title="All Projects" description="A complete portfolio of AI Product Specialist projects by Aldy Ardiansyah, backed by Fullstack Machine Learning Engineering: computer vision, OCR document intelligence, RAG and LLM integration, MLOps, IoT, and full-stack web applications." schema={schema}>
  <PageHeader
    eyebrow="Selected Work"
    title="All projects"
    subtitle={`${projects.length} projects across machine learning, computer vision, OCR, RAG, and full-stack engineering.`}
    crumbs={[{ name: 'Home', href: '/' }, { name: 'Projects' }]}
  />

  <div class="container-lux pb-28">
    <div class="mb-8 flex flex-wrap items-center gap-2" id="filter-bar">
      <button data-filter="All" class="filter-pill is-active">All</button>
      {categories.map((c) => (
        <button data-filter={c} class="filter-pill">{c}</button>
      ))}
      <span class="ml-2 text-sm text-gray-500" id="filter-count"></span>
      <span class="ml-auto flex gap-1 rounded-full border border-white/10 p-1">
        <button data-sort="newest" class="sort-btn is-active">Newest</button>
        <button data-sort="oldest" class="sort-btn">Oldest</button>
      </span>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" id="project-grid">
      {projects.map((p) => (
        <a href={`/projects/${p.id}`} data-category={p.category} data-sort-key={sortKey(p.timeline)} class="tilt border-grad group flex flex-col overflow-hidden rounded-2xl">
          <div class="relative aspect-video overflow-hidden">
            <img src={p.card_image_src} alt={p.name} loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" style={`view-transition-name: project-${p.id}`} />
            <span class="absolute right-3 top-3 rounded-full border border-emerald-500/40 bg-gray-950/60 px-2.5 py-1 text-xs text-emerald-400 backdrop-blur-sm">{p.category}</span>
          </div>
          <div class="flex flex-1 flex-col p-6">
            <h2 class="font-display text-xl font-semibold text-gray-100 transition-colors group-hover:text-neon">{p.name}</h2>
            <p class="mt-1 text-sm text-neon">{p.role}</p>
            <p class="mt-3 line-clamp-3 flex-1 text-sm leading-relaxed text-gray-400">{p.overview}</p>
            <div class="mt-4 flex flex-wrap items-center gap-1.5">
              {(stacks.get(p.id) ?? []).slice(0, CARD_STACK).map((t) => (
                <span class="tech-chip" title={t.label}>
                  {t.icon
                    ? <img src={t.icon} alt={t.label} width="14" height="14" loading="lazy" decoding="async" />
                    : <span class="tech-badge__mono" aria-hidden="true">{t.mono}</span>}
                </span>
              ))}
              {(stacks.get(p.id) ?? []).length > CARD_STACK && (
                <span class="tech-chip tech-chip--more" title={`${(stacks.get(p.id) ?? []).length - CARD_STACK} more tools in the project detail`}>
                  +{(stacks.get(p.id) ?? []).length - CARD_STACK}
                </span>
              )}
            </div>
            <span class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-gray-300 group-hover:text-emerald-400">
              View project <span class="transition-transform group-hover:translate-x-1">→</span>
            </span>
          </div>
        </a>
      ))}
    </div>

    <a href="/" class="group mt-16 inline-flex items-center gap-2 font-display text-gray-200 hover:text-emerald-400">
      <span class="transition-transform group-hover:-translate-x-1">←</span> Back to home
    </a>
  </div>
  <style>
    .filter-pill { border-radius: 9999px; border: 1px solid rgba(255,255,255,.12); padding: .4rem 1rem; font-size: .85rem; color: #d1d5db; transition: all .2s; }
    .filter-pill:hover { border-color: rgba(79,227,255,.6); color: #4fe3ff; }
    .filter-pill.is-active { background: rgba(30,128,255,.2); border-color: rgba(79,227,255,.7); color: #4fe3ff; font-weight: 600; box-shadow: 0 0 12px rgba(79,227,255,.25); }
    .sort-btn { border-radius: 9999px; padding: .35rem .9rem; font-size: .85rem; color: #9ca3af; }
    .sort-btn.is-active { background: rgba(30,128,255,.2); color: #4fe3ff; font-weight: 600; }
  </style>
  <script is:inline>
    const grid = document.getElementById('project-grid');
    const cards = grid ? Array.from(grid.children) : [];
    const pills = Array.from(document.querySelectorAll('.filter-pill'));
    const sortBtns = Array.from(document.querySelectorAll('.sort-btn'));
    const count = document.getElementById('filter-count');
    let activeFilter = 'All';
    let activeSort = 'newest';
    const apply = () => {
      const visible = [];
      cards.forEach((el) => {
        const show = activeFilter === 'All' || el.dataset.category === activeFilter;
        el.classList.toggle('hidden', !show);
        if (show) visible.push(el);
      });
      visible.sort((a, b) => {
        const ka = parseInt(a.dataset.sortKey || '0');
        const kb = parseInt(b.dataset.sortKey || '0');
        return activeSort === 'newest' ? kb - ka : ka - kb;
      });
      visible.forEach((c) => grid && grid.appendChild(c));
      if (count) count.textContent = `Showing ${visible.length} of ${cards.length}`;
    };
    pills.forEach((b) => b.addEventListener('click', () => {
      pills.forEach((x) => x.classList.remove('is-active'));
      b.classList.add('is-active');
      activeFilter = b.dataset.filter || 'All';
      apply();
    }));
    sortBtns.forEach((b) => b.addEventListener('click', () => {
      sortBtns.forEach((x) => x.classList.remove('is-active'));
      b.classList.add('is-active');
      activeSort = b.dataset.sort || 'newest';
      apply();
    }));
    apply();
  </script>
</PageLayout>
