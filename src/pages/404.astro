---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="Page not found" description="The page you are looking for does not exist on Aldy Ardiansyah's portfolio." robots="noindex, nofollow">
  <div class="container-lux flex min-h-[70vh] flex-col items-center justify-center py-24 text-center">
    <p class="eyebrow reveal">Error 404</p>
    <h1 class="reveal display-md mt-4 text-gray-100">This page drifted off the map</h1>
    <p class="reveal mt-5 max-w-md text-gray-400">
      The link may be old or mistyped. The portfolio itself is one step back.
    </p>
    <a href="/" class="magnetic glow reveal mt-10 rounded-2xl bg-emerald-500 px-8 py-3.5 font-semibold text-white transition-colors hover:bg-emerald-600">
      Back to home
    </a>
  </div>
</PageLayout>
